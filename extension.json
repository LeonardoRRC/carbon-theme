{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "carbon-theme",
    "name": "Carbon Theme",
    "version": "1.3.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "Carbon dark palettes with a live admin editor: console and file manager designs, layouts, server cards, fonts, branding, sidebar groups, and 50,000+ navigation icons.",
    "author": "The Quantum Development",
    "icon": "palette",
    "provider": "UK\\TheQuantum\\CarbonTheme\\CarbonThemeProvider",
    "autoload": {
        "UK\\TheQuantum\\CarbonTheme\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "ct",
        "screens": [
            {
                "id": "settings",
                "area": "admin",
                "path": "carbon-theme",
                "nav": {
                    "label": "Carbon Theme",
                    "icon": "palette"
                }
            }
        ],
        "components": [
            "dashboard.serverCard",
            "server.files.manager",
            "server.files.details"
        ]
    }
}
